ID_LIB MENU DISCARDABLE 
BEGIN
 

    POPUP "События Компаса"
    BEGIN
        MENUITEM "Подписаться",                              10
        MENUITEM "Отписаться",                               11
    END
    POPUP "События документов"
    BEGIN
        MENUITEM "Подписаться",                              20
        MENUITEM "Отписаться",                               21
    END
    POPUP "События 2D документов"
    BEGIN
        MENUITEM "Подписаться",                              22
        MENUITEM "Отписаться",                               23
    END

    POPUP "События объектов 2D документа"
    BEGIN
        MENUITEM "Подписаться",                              30
        MENUITEM "Отписаться",                               31
				MENUITEM SEPARATOR
        MENUITEM "Подписаться на события вида по номеру",    32
        MENUITEM "Отписаться от событий для вида по номеру", 33
				MENUITEM SEPARATOR
        MENUITEM "Подписаться на события слоя по номеру",    34
        MENUITEM "Отписаться от событий для слоя по номеру", 35
				MENUITEM SEPARATOR
        MENUITEM "Отписаться от всех событий объектов 2D",   36
    END
    POPUP "События селектирования"
    BEGIN
        MENUITEM "Подписаться",                              40
        MENUITEM "Отписаться",                               41
    END
    POPUP "События штампа"
    BEGIN
        MENUITEM "Подписаться",                              50
        MENUITEM "Отписаться",                               51
    END
    POPUP "События 3D документа"
    BEGIN
        MENUITEM "Подписаться",                              60
        MENUITEM "Отписаться",                               61
    END
