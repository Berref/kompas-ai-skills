            MENUITEM "Коническая спираль",                                   o3d_conicSpiral        + 700  
            MENUITEM "Сплайн",                                               o3d_spline             + 700  
            MENUITEM "Цилиндрическая спираль",                               o3d_cylindricSpiral    + 700  
            MENUITEM "Импортирванная поверхность",                           o3d_importedSurface    + 700  
            MENUITEM "Условное изображение резьбы",                          o3d_thread             + 700
            MENUITEM "Компонента"                                            o3d_part               + 700
            MENUITEM "Объект дерева"                                         o3d_feature            + 700  
        END

        MENUITEM "Отписать все",                                90
    END
    POPUP "События объекта спецификации"
    BEGIN
        POPUP "Подписаться",                 
        BEGIN
				    MENUITEM "Текущий объект",                          100
            MENUITEM SEPARATOR
            MENUITEM "Все объекты",                               300
            MENUITEM "Базовый объект",          SPC_BASE_OBJECT + 300
            MENUITEM "Комментарий",             SPC_COMMENT     + 300
//#define  SPC_SECTION_NAME    3    // наименование раздела ( создается по стилю СП автоматически )
//#define  SPC_BLOCK_NAME      4    // наименование блока исполнений ( создается по стилю СП автоматически )
//#define  SPC_RESERVE_STR     5    // резервная строка ( создается по стилю СП автоматически )
//#define  SPC_EMPTY_STR       6    // пустая строка ( создается по стилю СП автоматически )
				END

        POPUP "Отписаться",    
        BEGIN   
				    MENUITEM "Текущий объект",                          110
            MENUITEM SEPARATOR
            MENUITEM "Все объекты",                               400
            MENUITEM "Базовый объект",          SPC_BASE_OBJECT + 400
            MENUITEM "Комментарий",             SPC_COMMENT     + 400
//#define  SPC_SECTION_NAME    3    // наименование раздела ( создается по стилю СП автоматически )
//#define  SPC_BLOCK_NAME      4    // наименование блока исполнений ( создается по стилю СП автоматически )
//#define  SPC_RESERVE_STR     5    // резервная строка ( создается по стилю СП автоматически )
//#define  SPC_EMPTY_STR       6    // пустая строка ( создается по стилю СП автоматически )
				END
        MENUITEM "Отписаться от всех объектов спецификации",     120
    END  
//    POPUP "События объектов спецификации"
//    BEGIN
//        MENUITEM "Подписаться",                 100
//        MENUITEM "Отписаться",                  110
//    END
    
		POPUP "События документа спецификации"
    BEGIN
        MENUITEM "Подписаться",                    130
        MENUITEM "Отписаться",                     131
    END

    POPUP "События спецификации"
    BEGIN
        MENUITEM "Подписаться",                    140
        MENUITEM "Отписаться",                     141
    END
    MENUITEM "Подписанные события",                997
    MENUITEM "Отписаться от всех",                 998
    MENUITEM "Конфигурация"                        999     

END

