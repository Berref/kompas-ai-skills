IDR_LIB MENU 
BEGIN
    POPUP "События Компаса"
    BEGIN
        MENUITEM "Подписаться",                 1
        MENUITEM "Отписаться",                  2
    END
    POPUP "События документов"
    BEGIN
        MENUITEM "Подписаться",                 3
        MENUITEM "Отписаться от всех событий документа", 4
    END
    POPUP "События объекта 2D документа"
    BEGIN
        MENUITEM "Подписаться",                 5
        MENUITEM "Отписаться",                  6
        MENUITEM "Отписаться от всех событий объектов 2D",   7
        MENUITEM SEPARATOR
        MENUITEM "Подписаться на события вида по номеру",    8
        MENUITEM "Отписаться от событий для вида по номеру", 9
