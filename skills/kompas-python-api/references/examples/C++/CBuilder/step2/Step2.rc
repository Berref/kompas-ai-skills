#ifndef __STEP2_RH
#include "step2.rh"
#endif 


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_LIBID MENU DISCARDABLE 
BEGIN
    MENUITEM "Пересечь прямые",             1
    MENUITEM "Пересечь кривые",             2
    MENUITEM "Пересечь отрезок и дугу",     3
    MENUITEM "Касательная  из точки",       4
    MENUITEM "Касательная  под углом",      5
    MENUITEM "Поворот точки",               6
    MENUITEM "Симметрия точки",             7
    MENUITEM "Сопрягающие окружности к двум прямым", 8
    MENUITEM "Перепендикуляр к отрезку",    9
END


/////////////////////////////////////////////////////////////////////////////
//
// String Table
//

STRINGTABLE DISCARDABLE 
BEGIN
    IDR_LIBID               "Математика"
END


/////////////////////////////////////////////////////////////////////////////
//
// Инструментальные панели
//

// Определение имени панелей  
STRINGTABLE 
{
  COMPACT_BAR1 "Компактная панель Математика"  
  BAR_1 "Инструментальная панель 1"
}

// Определение состава
COMPACT_BAR1 RCDATA
{
  BAR_1 // Инструментальная панель, входящая в компактную     
  END_OF_RESOURCE_TABLE     
}

// Определение состава панели
BAR_1 RCDATA
{
  1 // Пересечь прямые
  2 // Пересечь кривые
	3 // Пересечь отрезок и дугу
	4 // Касательная из точки
	5 // Касательная под углом
	6 // Поворот точки
	7 // Симметрия точки
	8 // Сопрягающие окружности к двум прямым
	9 // Перепендикуляр
	END_OF_RESOURCE_TABLE
}

// Определение иконок инструментальной панели при включении её в компактную панель:
BAR_1 ICON DISCARDABLE "bar1.ico" 

1001 BITMAP "1.bmp"
1002 BITMAP "2.bmp"
1003 BITMAP "3.bmp"
1004 BITMAP "4.bmp"
1005 BITMAP "5.bmp"
1006 BITMAP "6.bmp"
1007 BITMAP "7.bmp"
1008 BITMAP "8.bmp"
1009 BITMAP "9.bmp"