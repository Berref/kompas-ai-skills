#------------------------------------------------------------------------------
VERSION = BWS.01
#------------------------------------------------------------------------------
!ifndef ROOT
ROOT = $(MAKEDIR)\..
!endif
#------------------------------------------------------------------------------
MAKE = $(ROOT)\bin\make.exe -$(MAKEFLAGS) -f$**
DCC = $(ROOT)\bin\dcc32.exe $**
BRCC = $(ROOT)\bin\brcc32.exe $**
#------------------------------------------------------------------------------
PROJECTS = step1.rtw step2.rtw step2a.rtw step3.rtw step3a.rtw step3d1.rtw \
  step3d2.rtw step4.rtw step3d3.rtw step5.rtw step7.rtw step9.rtw step8.rtw \
  step10.rtw studs3d.rtw
#------------------------------------------------------------------------------
default: $(PROJECTS)
#------------------------------------------------------------------------------

step1.rtw: step1\step1.bpr
  $(ROOT)\bin\bpr2mak $**
  $(ROOT)\bin\make -$(MAKEFLAGS) -f$*.mak

