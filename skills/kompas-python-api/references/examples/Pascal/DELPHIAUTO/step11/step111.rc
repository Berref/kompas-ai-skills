// Ресурс с составом дерева команд
ID_TREE_CONTENTS MENU
{
  MENUITEM "Item 1"  ID_COMMAND_1
  MENUITEM "Item 2"  ID_COMMAND_2

  POPUP "Node 1"
  {
    MENUITEM "Item 1.1"  ID_COMMAND_1_1
    MENUITEM "Item 1.2"  ID_COMMAND_1_2
    MENUITEM "Item 1.3"  ID_COMMAND_1_3
  }

  POPUP "Node 2"
  {
    POPUP "Node 2.1"
    {
      MENUITEM "Item 2.1.1"  ID_COMMAND_2_1_1
      MENUITEM "Item 2.1.2"  ID_COMMAND_2_1_2
      MENUITEM "Item 2.1.3"  ID_COMMAND_2_1_3
    }
    POPUP "Node 2.2"
    {
