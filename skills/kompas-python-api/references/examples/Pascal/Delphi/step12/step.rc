
100 RCDATA
{
 0
 0
}

// Определение имени панелей
STRINGTABLE
{
  2000 "Библиотечная панель свойств"
  2001 "Инструментальная панель 1"
  100  "Пример создания панели свойств (Delphi)"

}

// Определение состава
2000 RCDATA
{
  2001 // Инструментальная панель, входящая в компактную
  0xffff //END_OF_RESOURCE_TABLE
}

// Определение состава панели
2001 RCDATA
{
	1 // Показать панель
	2 // Скрыть панель
	0xffff //END_OF_RESOURCE_TABLE
}


1001 BITMAP "res\1001.bmp"
1002 BITMAP "res\1002.bmp"


// Определение иконок инструментальной панели при включении её в компактную панель:
2001 ICON DISCARDABLE "res\bar1.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//
100 MENU
BEGIN
  POPUP "Панель свойств"
  BEGIN
    MENUITEM "Создать закладку и подписаться", 1
    MENUITEM "Отписаться",                     2
  END
END


